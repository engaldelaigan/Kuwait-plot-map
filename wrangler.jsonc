{
  // The viewer's static files, plus a Worker in front of them that proxies
  // every Supabase call (see worker.js). The Worker holds the key, so it is
  // never served to a browser.
  //
  // run_worker_first sends every request to the Worker, which serves the site's
  // own files straight back through the ASSETS binding and handles /api/*
  // itself. The per-route array form was tried first and silently did nothing:
  // /api/* fell through to the asset server and returned its bodyless 404
  // without the Worker ever running.
  "name": "kuwait-plot-map",
  "compatibility_date": "2026-08-01",
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "SUPABASE_URL": "https://qfvhegueptllwojefxly.supabase.co"
  },
  // Freezes the monthly usage figures so they outlive the raw event rows,
  // which expire. Daily at 02:00 UTC rather than monthly: the figure that has
  // to be right is a month that has already ended, and running it every day
  // means a missed run is a day late instead of a year's history lost. The
  // function it calls does nothing when the last two months were already
  // built within six hours, so the other runs cost one round trip.
  "triggers": {
    "crons": ["0 2 * * *"]
  },
  // Per-IP rate limiting at the edge. A viewport change costs two calls, so
  // even hard panning sits well under 120 a minute; a script walking the
  // country needs at least 312 requests just to clear the 1,000-row cap, and
  // this holds it to roughly a request every half second.
  "unsafe": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 120, "period": 60 }
      }
    ]
  }
}
